  <Flow>
    <Routine name="LSL_definition"/>
    <Routine name="Pause_for_LSL"/>
    <Routine name="Instructions"/>
    <LoopInitiator loopType="TrialHandler" name="practice">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('stimulus', 'HHHHH'), ('correct_answer', 'f'), ('condition', 'congruent')]), OrderedDict([('stimulus', 'AAAAA'), ('correct_answer', 'j'), ('condition', 'congruent')]), OrderedDict([('stimulus', 'HHAHH'), ('correct_answer', 'j'), ('condition', 'incongruent')]), OrderedDict([('stimulus', 'AAHAA'), ('correct_answer', 'f'), ('condition', 'incongruent')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="practice" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Fixation"/>
    <Routine name="Stimulus"/>
    <Routine name="Feedback"/>
    <Routine name="Between_trials"/>
    <LoopTerminator name="practice"/>
    <Routine name="start_trials"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('stimulus', 'HHHHH'), ('correct_answer', 'f'), ('condition', 'congruent')]), OrderedDict([('stimulus', 'AAAAA'), ('correct_answer', 'j'), ('condition', 'congruent')]), OrderedDict([('stimulus', 'HHAHH'), ('correct_answer', 'j'), ('condition', 'incongruent')]), OrderedDict([('stimulus', 'AAHAA'), ('correct_answer', 'f'), ('condition', 'incongruent')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="15" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Fixation"/>
    <Routine name="Stimulus"/>
    <Routine name="Feedback"/>
    <Routine name="Between_trials"/>
    <LoopTerminator name="trials"/>
  </Flow>
</PsychoPy2experiment>
