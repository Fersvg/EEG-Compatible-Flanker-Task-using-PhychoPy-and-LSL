      <CodeComponent name="code" plugin="None">
        <Param val="from pylsl import StreamInfo, StreamOutlet&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="import {StreamInfo, StreamOutlet} from 'pylsl';&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="info = StreamInfo(name='PschoPy_LSL', type='Markers', channel_count=1, nominal_srate=0, channel_format='string', source_id='psy_marker')&amp;#10;&amp;#10;outlet = StreamOutlet(info) # Broadcast the stream" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="info = new StreamInfo({&quot;name&quot;: &quot;PschoPy_LSL&quot;, &quot;type&quot;: &quot;Markers&quot;, &quot;channel_count&quot;: 1, &quot;nominal_srate&quot;: 0, &quot;channel_format&quot;: &quot;string&quot;, &quot;source_id&quot;: &quot;psy_marker&quot;});&amp;#10;outlet = new StreamOutlet(info);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="# 1. Enviar un marcador de final (opcional però recomanat)&amp;#10;outlet.push_sample(['EndOfExperiment'])&amp;#10;&amp;#10;# 2. Eliminar l'objecte explicitament&amp;#10;# Això invoca el destructor de la llibreria pylsl que tanca el stream&amp;#10;del outlet&amp;#10;&amp;#10;# 3. Sortida neta de PsychoPy&amp;#10;win.close()&amp;#10;core.quit()" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="outlet.push_sample([&quot;EndOfExperiment&quot;]);&amp;#10;delete outlet;&amp;#10;psychoJS.window.close();&amp;#10;core.quit();&amp;#10;" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
